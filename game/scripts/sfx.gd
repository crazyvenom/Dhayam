class_name Sfx
extends Node
## Plays the game's sound effects (files are generated by tools/synth_sounds.gd).

const NAMES: Array = [
	"dice_roll", "step", "coin_out", "capture", "safe", "finish",
	"roll_normal", "roll_1", "roll_5", "roll_6", "roll_12", "fail", "win", "tick",
]
## Volume of each sound in dB (all files are normalised, so this sets the mix).
const VOLUME: Dictionary = {
	"dice_roll": -4.0, "step": -9.0, "coin_out": -5.0, "capture": -2.0, "safe": -5.0,
	"finish": -4.0, "roll_normal": -6.0, "roll_1": -3.0, "roll_5": -3.0, "roll_6": -3.0,
	"roll_12": -1.0, "fail": -5.0, "win": -1.0, "tick": -10.0,
}

var muted: bool = false
var _streams: Dictionary = {}
var _players: Array = []
var _next: int = 0


func _ready() -> void:
	for n in NAMES:
		var path: String = "res://audio/%s.wav" % n
		if ResourceLoader.exists(path):
			_streams[n] = load(path)
	for i in 10:
		var p: AudioStreamPlayer = AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)


func play(sound: String, pitch: float = 1.0) -> void:
	if muted or not _streams.has(sound):
		return
	var p: AudioStreamPlayer = _players[_next]
	_next = (_next + 1) % _players.size()
	p.stream = _streams[sound]
	p.volume_db = VOLUME.get(sound, 0.0)
	p.pitch_scale = pitch
	p.play()


## The sound for a dice result: 1, 5, 6 and 12 each have their own; everything else is a soft tok.
func play_result(v: int) -> void:
	match v:
		1, 5, 6, 12:
			play("roll_%d" % v)
		_:
			play("roll_normal")
